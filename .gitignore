# Generated zig, gold chapters, the wasm module and the bundled units are tracked,
# per Steve 2026-08-29 ("just add everything for now"). Compiled executables and
# the harness's skip stamps are not.
#
# PATTERNS, NOT A HAND-LIST OF EVERY BINARY. The old file named all twenty-three
# by hand, which quietly broke README's "add three files and nothing else" rule:
# a new module actually needed two more lines here, and forgetting them commits a
# 3.7 MB blob that git keeps forever.
#
# Executables are left out because they are pure `zig build-exe` output and
# ./harness/run.sh remakes them from nothing in about a second each.
build/*
!build/*.zig
!build/*.codex
!build/*.diag
!build/*.wasm

# The probes, likewise: sources tracked, binaries not.
probe/probe_*
!probe/probe_*.zig

.zig-cache/
*.o

# Spike output: throwaway stills, 150-200 KB each and regenerated by
# ./harness/spike.sh in seconds. The tooling is tracked; the pictures are not.
web/spikes/

# Python bytecode caches. harness/ modules import each other -- metal.py takes
# bundle.py's snake(), spike.sh drives spike_svg.py -- and an import writes one of
# these. Nothing here is authored.
__pycache__/

# The fourth arm's wasm. Both roads produce a module per check and neither is a
# deliverable: `harness/wasm_arm.py` remakes the left one in a second and the
# right one is two guests. `build/safari_codex.wasm` is the browser's module and
# stays tracked, which is why these are named rather than the extension dropped.
build/*_zig.wasm
build/*_plug.wasm
build/*_wasi.zig
# The wasm plug's bundle and kernel: 280 KB of ANOTHER repo's source, glued
# together by harness/bundle_wasmplug.ps1 and identified by the .fp beside it.
# Tracking a copy of Cobblestone here would be a second copy that drifts.
build/wasmringplug*

# npm's tree for wabt. package.json and package-lock.json pin it; the tree is
# 'npm ci' away and has no business in this history.
tools/node_modules/

# wasmtime, fetched by tools/README.md and 100 MB unpacked. It is a released
# binary, not something this project builds, and the version is pinned in
# PROVENANCE.md.
tools/bin/

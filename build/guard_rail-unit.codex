  g-rail-coords = [573.47876, 311.68484, 600.97253, 315.12155, 600.97253, 313.10535, 573.47876, 310.12686, 600.97253, 315.12155, 651.37775, 321.4222, 651.37775, 318.56592, 600.97253, 313.10535, 651.37775, 321.4222, 769.87317, 329.37903, 769.87317, 325.46182, 651.37775, 318.56592, 769.87317, 329.37903, 1060.0477, 339.5487, 1060.0477, 334.27554, 769.87317, 325.46182, 1060.0477, 339.5487, 1502.2532, 345.09943, 1502.2532, 339.08615, 1060.0477, 334.27554, 1502.2532, 345.09943, 2103.5786, 345.09943, 2103.5786, 339.08615, 1502.2532, 339.08615, 573.4575, 318.6915, 573.5, 318.7, 573.5, 310.12918, 573.4575, 310.12457, 600.93695, 324.18738, 601.0081, 324.20163, 601.0081, 313.10922, 600.93695, 313.1015, 651.2825, 334.26132, 651.4731, 334.2898, 651.4731, 318.57364, 651.2825, 318.55823, 769.5604, 346.98203, 770.1863, 347.03094, 770.1863, 325.4751, 769.5604, 325.4486, 1059.3635, 363.25183, 1060.7324, 363.30405, 1060.7324, 334.2897, 1059.3635, 334.2614, 1501.5657, 372.15277, 1502.9407, 372.16534, 1502.9407, 339.08957, 1501.5657, 339.08273, 2102.9773, 372.15906, 2104.18, 372.15906, 2104.18, 339.08615, 2102.9773, 339.08615, 342.89783, 325.70667, 251.49635, 342.84442, 251.49635, 337.13184, 342.89783, 322.2791, 251.49635, 342.84442, 342.89783, 325.70667, 342.89783, 322.2791, 251.49635, 337.13184, 342.89783, 325.70667, -34.13318, 385.68887, -34.13318, 374.26367, 342.89783, 322.2791, 342.96634, 341.1101, 342.82922, 341.15125, 342.82922, 322.29025, 342.96634, 322.26797, 251.49635, 368.5511, 251.49635, 368.5511, 251.49635, 337.13184, 251.49635, 337.13184, 342.99457, 341.11017, 342.80096, 341.15115, 342.80096, 322.29022, 342.99457, 322.268, -33.23755, 436.8742, -35.0318, 437.33093, -35.0318, 374.38757, -33.23755, 374.1402, 5633.151, 1585.333, 845.60583, 385.68887, 845.60583, 374.26367, 5633.151, 1413.9553, 845.60583, 385.68887, 562.2613, 317.1378, 562.2613, 314.85272, 845.60583, 374.26367, 846.19305, 437.33102, 845.02057, 436.8741, 845.02057, 374.14014, 846.19305, 374.38763, 562.2849, 327.4
  Tup5 (a) (b) (c) (d) (e) =
    | MkTup5 (a) (b) (c) (d) (e)

  pair-first : (a, b) -> a
  pair-first (p) =
   let (x, y) = p in x

  pair-second : (a, b) -> b
  pair-second (p) =
   let (x, y) = p in y


  g-water-outline = [-2.0, 3.0, -28.0, 3.0, -31.0, 14.0, -26.0, 28.0, -15.0, 32.0, -5.0, 29.0, -1.0, 16.0]

  g-bank : List Real
  g-bank = [-5.0, 29.0, -15.0, 32.0, -26.0, 28.0, -26.0, 29.0, -15.0, 33.0, -5.0, 30.0]

  g-ducks-p : List Real
  g-ducks-p = [-8.0, 11.0, -16.0, 17.0, -9.0, 21.0, -4.0, 6.0, -12.0, 7.0, -20.0, 8.0]

  g-duck-height : List Real
  g-duck-height = [0.9]

  g-water-color : List Integer
  g-water-color = [3112588]

  g-bank-color : List Integer
  g-bank-color = [12759680]

  g-duck-codepoint : List Integer
  g-duck-codepoint = [129414]


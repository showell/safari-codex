Chapter: ListUtils

 We say:

Section: Construction
  list-zeros : Integer -> List Integer
  list-zeros (n) = list-zeros-loop n 0 []

  list-zeros-loop : Integer, Integer, List Integer -> List Integer
  list-zeros-loop (n) (i) (acc) =
    if i >= n then acc
    else list-zeros-loop n (i + 1) (list-push acc 0)

Section: Slicing
  list-tail : List a -> List a
  list-tail (xs) = list-tail-loop xs 1 (list-length xs) []

  list-tail-loop : List a, Integer, Integer, List a -> List a
  list-tail-loop (xs) (i) (len) (acc) =
    if i >= len then acc
    else list-tail-loop xs (i + 1) len (list-push acc (list-at xs i))

Section: Slicing (extended)

  list-take : List a, Integer -> List a
  list-take (xs) (n) = list-take-loop xs 0 (if n > list-length xs then list-length xs else n) []

  list-take-loop : List a, Integer, Integer, List a -> List a
  list-take-loop (xs) (i) (n) (acc) =
    if i >= n then acc
    else list-take-loop xs (i + 1) n (list-push acc (list-at xs i))

  list-drop : List a, Integer -> List a
  list-drop (xs) (n) = list-tail-loop xs (if n > list-length xs then list-length xs else n) (list-length xs) []

Section: Map and Fold

  list-map : (a -> [e] b), List a -> [e] List b
  list-map (f) (xs) = map-list f xs

  map-list : (a -> [e] b), List a -> [e] List b
  map-list (f) (xs) =
   map-list-loop f xs 0 (list-length xs) []

  map-list-loop : (a -> [e] b), List a, Integer, Integer, List b -> [e] List b
  map-list-loop (f) (xs) (i) (len) (acc) =
   if i == len then acc
   else map-list-loop f xs (i + 1) len (list-push acc (f (list-at xs i)))

  fold-list : (b, a -> [e] b), b, List a -> [e] b
  fold-list (f) (z) (xs) =
   fold-list-loop f z xs 0 (list-length xs)

  fold-list-loop : (b, a -> [e] b), b, List a, Integer, Integer -> [e] b
  fold-list-loop (f) (z) (xs) (i) (len) =
   if i == len then z
   else fold-list-loop f (f z (list-at xs i)) xs (i + 1) len

Section: Filter and Search

  list-filter : List a, (a -> [e] Boolean) -> [e] List a
  list-filter (xs) (pred) =
    list-filter-loop xs pred 0 (list-length xs) []

  list-filter-loop : List a, (a -> [e] Boolean), Integer, Integer, List a -> [e] List a
  list-filter-loop (xs) (pred) (i) (len) (acc) =
    if i >= len then acc
    else let x = list-at xs i
    in if pred x then list-filter-loop xs pred (i + 1) len (list-push acc x)
    else list-filter-loop xs pred (i + 1) len acc

  list-contains : List a, (a -> Boolean) -> Boolean
  list-contains (xs) (pred) =
    list-contains-loop xs pred 0 (list-length xs)

  list-contains-loop : List a, (a -> Boolean), Integer, Integer -> Boolean
  list-contains-loop (xs) (pred) (i) (len) =
    if i >= len then False
    else if pred (list-at xs i) then True
    else list-contains-loop xs pred (i + 1) len

  list-remove : List a, (a -> Boolean) -> List a
  list-remove (xs) (pred) =
    list-remove-loop xs pred 0 (list-length xs) [] False

  list-remove-loop : List a, (a -> Boolean), Integer, Integer, List a, Boolean -> List a
  list-remove-loop (xs) (pred) (i) (len) (acc) (found) =
    if i >= len then acc
    else let x = list-at xs i
    in if found then list-remove-loop xs pred (i + 1) len (list-push acc x) True
    else if pred x then list-remove-loop xs pred (i + 1) len acc True
    else list-remove-loop xs pred (i + 1) len (list-push acc x) False


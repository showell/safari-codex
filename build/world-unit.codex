  g-w-exitangle : List Real
  g-w-exitangle = [0.87266463, 1.2217305, 0.34906584, 0.34906584, 1.2217305, 1.2217305, 1.3962634, 0.2617994, 1.2217305, 0.2617994, 0.2617994, 0.2617994, 0.2617994, 0.87266463, 0.87266463, 0.87266463, 0.87266463, 0.87266463, 0.0]

  g-w-commit : List Real
  g-w-commit = [498.3218, 319.27206, 394.50504, 294.50504, 299.27206, 299.27206, 1199.6473, 292.5359, 299.27206, 792.5359, 292.5359, 292.5359, 292.5359, 398.3218, 298.3218, 298.3218, 298.3218, 298.3218, 300.0]


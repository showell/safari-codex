Chapter: Tuple

Section: Definitions

  Tup2 (a) (b) =
    | MkTup2 (a) (b)

  Tup3 (a) (b) (c) =
    | MkTup3 (a) (b) (c)

  Tup4 (a) (b) (c) (d) =
    | MkTup4 (a) (b) (c) (d)

  Tup5 (a) (b) (c) (d) (e) =
    | MkTup5 (a) (b) (c) (d) (e)

  pair-first : (a, b) -> a
  pair-first (p) =
   let (x, y) = p in x

  pair-second : (a, b) -> b
  pair-second (p) =
   let (x, y) = p in y


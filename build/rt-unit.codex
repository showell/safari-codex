  got : Integer -> List Integer
  got (i) =
    if i >= list-length lits then []
    else [real-to-bits (list-at lits i)] & got (i + 1)

  bad-from : List Integer, Integer, Integer -> Integer
  bad-from (g) (i) (n) =
    if i >= list-length g then n
    else if list-at g i /= list-at want i then bad-from g (i + 1) (n + 1)
    else bad-from g (i + 1) n

  off-by-from : List Integer, Integer, Integer -> Integer
  off-by-from (g) (i) (worst) =
    if i >= list-length g then worst
    else let d = list-at g i - list-at want i
    in let a = if d < 0 then 0 - d else d
    in off-by-from g (i + 1) (if a > worst then a else worst)

Section: Entry

  opening : [Console] Nothing = act
    print-line-uni (grade-ints "how many of 120 differ" [bad-from (got 0) 0 0] [0])
    print-line-uni (grade-ints "worst ulp gap        " [off-by-from (got 0) 0 0] [0])
  end
